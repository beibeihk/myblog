<%
var firstPage = (page.current || 1) === 1
page.lab_home = firstPage
page.lab_wide = true
page.banner_img = theme.index.banner_img
page.banner_img_height = firstPage ? theme.index.banner_img_height : 44
page.banner_mask_alpha = firstPage ? theme.index.banner_mask_alpha : 0.2
page.subtitle = firstPage ? config.subtitle : '文章'
%>

<div id="lab-home" class="lab-home <%= firstPage ? 'lab-home-first' : 'lab-home-archive' %>">
  <% if (firstPage) { %>
    <section class="lab-signature" aria-label="博客签名">
      <p class="lab-signature-text">摛门不安横，无复相关意。</p>
    </section>
    <section class="lab-introduction" aria-labelledby="lab-intro-title">
      <div class="lab-intro-copy">
        <h2 id="lab-intro-title">你好，我是黄坤。</h2>
        <p>在武汉读财政学博士。写研究，也记下书、城市、梦想和感情。</p>
        <p class="lab-personal-tags">双鱼男 <span aria-hidden="true">·</span> INFP</p>
      </div>
      <a class="lab-intro-portrait" href="<%= url_for('/about/') %>" aria-label="进一步认识黄坤"><img src="<%= url_for('/img/dreamer.jpg') %>" alt="黄坤原有博客头像：电影《白日梦想家》画面" loading="eager"><span>关于我 <span aria-hidden="true">↗</span></span></a>
    </section>
  <% } %>

  <div class="lab-editorial-grid">
    <section class="lab-writing" aria-labelledby="lab-writing-title">
      <div class="lab-section-heading">
        <div>
          <p class="lab-eyebrow"><%= firstPage ? '最近的文字 / JOURNAL' : '文章目录 / ARCHIVE' %></p>
          <h2 id="lab-writing-title"><%= firstPage ? '最近写下的' : '文章' %></h2>
        </div>
        <% if (firstPage) { %><a class="lab-text-link" href="<%= url_for('/archives/') %>">全部文章 <span aria-hidden="true">↗</span></a><% } %>
      </div>
      <ol class="lab-article-list">
        <% page.posts.each(function (post) { %>
          <% var summary = post.summary || post.description || post.excerpt || post.content || '' %>
          <li>
            <article class="lab-article-entry">
              <time class="lab-article-date" datetime="<%= full_date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
              <div class="lab-article-copy">
                <h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
                <p><%= strip_html(summary).substring(0, 150).trim().replace(/\n/g, ' ') %></p>
                <a class="lab-entry-link" href="<%= url_for(post.path) %>">读这篇文章 <span aria-hidden="true">↗</span></a>
              </div>
            </article>
          </li>
        <% }) %>
      </ol>
    </section>

    <% if (firstPage) { %>
      <aside class="lab-side-notes" aria-label="博客其他入口">
        <div class="lab-side-note">
          <p class="lab-eyebrow">继续逛逛</p>
          <nav aria-label="博客栏目">
            <a href="<%= url_for('/works/') %>"><span>作品</span><span aria-hidden="true">↗</span></a>
            <a href="<%= url_for('/moments/') %>"><span>片刻</span><span aria-hidden="true">↗</span></a>
            <a href="<%= url_for('/resume/') %>"><span>简历</span><span aria-hidden="true">↗</span></a>
            <a href="<%= url_for('/about/') %>"><span>关于</span><span aria-hidden="true">↗</span></a>
          </nav>
        </div>
      </aside>
    <% } %>
  </div>

  <%- partial('_partials/paginator') %>
</div>
