<%
var firstPage = (page.current || 1) === 1
page.lab_home = firstPage
page.lab_wide = true
page.banner_img = theme.index.banner_img
page.banner_img_height = firstPage ? theme.index.banner_img_height : 44
page.banner_mask_alpha = firstPage ? theme.index.banner_mask_alpha : 0.2
page.subtitle = firstPage ? config.subtitle : '文章'
%>

<div id="lab-home" class="lab-home">
  <% if (firstPage) { %>
    <section class="lab-section lab-introduction lab-reveal" aria-labelledby="lab-intro-title">
      <div class="lab-intro-copy">
        <p class="lab-eyebrow">A SMALL CORNER OF THE INTERNET · 个人博客</p>
        <h2 id="lab-intro-title">你好，我是黄坤。</h2>
        <p>在武汉读财政学博士，也喜欢把读到的、想到的和经历过的事写下来。这里有论文与方法，也会有书、城市、游戏和生活。</p>
        <p class="lab-intro-english" lang="en">Research, essays, and fragments of everyday life — written from Wuhan.</p>
        <p class="lab-personal-tags">双鱼男 <span aria-hidden="true">·</span> INFP <span aria-hidden="true">·</span> 永远对新问题好奇</p>
      </div>
      <a class="lab-intro-portrait" href="<%= url_for('/about/') %>" aria-label="进一步认识黄坤"><img src="<%= url_for('/img/dreamer.jpg') %>" alt="黄坤原有博客头像：电影《白日梦想家》画面" loading="eager"><span>关于我 <span aria-hidden="true">↗</span></span></a>
    </section>

    <section class="lab-section lab-reveal" aria-label="探索这个博客">
      <div class="lab-section-heading"><div><p class="lab-eyebrow">FIND YOUR WAY</p><h2>从这里开始</h2></div></div>
      <div class="lab-doors">
        <a class="lab-door" href="<%= url_for('/archives/') %>"><span class="lab-door-no">01 / JOURNAL</span><h3>文章</h3><p>研究札记，也有学术之外的自由表达。</p><span class="lab-door-arrow" aria-hidden="true">↗</span></a>
        <a class="lab-door" href="<%= url_for('/research/') %>"><span class="lab-door-no">02 / RESEARCH</span><h3>研究成果</h3><p>已发表论文与正在进行的研究。</p><span class="lab-door-arrow" aria-hidden="true">↗</span></a>
        <a class="lab-door" href="<%= url_for('/resume/') %>"><span class="lab-door-no">03 / ACADEMIC CV</span><h3>学术简历</h3><p>教育经历、研究项目与其他学术工作。</p><span class="lab-door-arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>
  <% } %>

  <section class="lab-section lab-writing lab-reveal" aria-labelledby="lab-writing-title">
    <div class="lab-section-heading">
      <div><p class="lab-eyebrow">NOTES & STORIES</p><h2 id="lab-writing-title"><%= firstPage ? '最近写下的' : '文章' %></h2><p>所有文章都在这里，不按学术与生活划线。</p></div>
      <% if (firstPage) { %><a class="lab-text-link" href="<%= url_for('/archives/') %>">全部文章 <span aria-hidden="true">↗</span></a><% } %>
    </div>
    <div class="lab-article-list">
      <% page.posts.each(function (post) { %>
        <% var summary = post.summary || post.description || post.excerpt || post.content || '' %>
        <article class="lab-article-card">
          <div class="lab-article-meta"><time datetime="<%= full_date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY-MM-DD') %></time><span aria-hidden="true">/</span><span>文章</span></div>
          <h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
          <p><%= strip_html(summary).substring(0, 165).trim().replace(/\n/g, ' ') %></p>
          <a class="lab-text-link" href="<%= url_for(post.path) %>">阅读全文 <span aria-hidden="true">↗</span></a>
        </article>
      <% }) %>
    </div>
  </section>

  <% if (firstPage) { %>
    <aside class="lab-letter lab-reveal" aria-label="给读者的一句话">
      <p class="lab-eyebrow">A NOTE TO THE READER</p>
      <p>有些问题值得写成论文，有些只适合留在一篇随笔里。这里都欢迎。</p>
      <a href="<%= url_for('/about/') %>">再认识我一点 <span aria-hidden="true">↗</span></a>
    </aside>
  <% } %>

  <%- partial('_partials/paginator') %>
</div>
